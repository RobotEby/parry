{
  "data": [
    {
      "name": "login-policy",
      "match": {
        "method": "POST",
        "path": "/login"
      },
      "inheritGlobalRateLimit": true,
      "rateLimit": {
        "enabled": true,
        "max": 20,
        "windowMs": 60000,
        "key": "ip"
      },
      "bruteForce": {
        "enabled": true,
        "maxAttempts": 5,
        "windowMs": 900000,
        "blockDurationMs": 600000,
        "keyTypes": ["ip", "body.email", "ip+body.email"],
        "resetOnSuccess": true
      }
    },
    {
      "name": "signup-policy",
      "match": {
        "method": "POST",
        "path": "/signup"
      },
      "inheritGlobalRateLimit": true,
      "rateLimit": {
        "enabled": true,
        "max": 10,
        "windowMs": 60000,
        "key": "ip"
      },
      "bruteForce": {
        "enabled": false,
        "maxAttempts": 10,
        "windowMs": 900000,
        "blockDurationMs": 600000,
        "keyTypes": ["ip"],
        "resetOnSuccess": true
      }
    }
  ],
  "pagination": {
    "limit": 50,
    "offset": 0,
    "total": 2
  }
}
